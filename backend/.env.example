# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/commercepulse
# For sync operations (Alembic, Celery)
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/commercepulse

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# S3 / Object Storage Configuration
S3_BUCKET=commercepulse-storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Authentication & Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production-please-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
CSRF_SECRET_KEY=change-this-csrf-secret-key-too

# Email / SMTP Configuration
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-or-smtp-api-key
MAIL_FROM=no-reply@commercepulse.ai
MAIL_FROM_NAME=CommercePulse
MAIL_PORT=587
MAIL_SERVER=smtp.sendgrid.net
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# CORS & App Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.commercepulse.ai
CORS_ORIGINS_REGEX=^https://.*\.commercepulse\.ai$
ENVIRONMENT=development
APP_NAME=CommercePulse
API_V1_PREFIX=/api/v1
DEBUG=False

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_STORAGE=redis

# Sentry Configuration (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# Organization Defaults
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCALE=en_US

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False
