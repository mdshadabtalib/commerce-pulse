# ========================================
# Database Configuration
# ========================================

# PostgreSQL master username
POSTGRES_USER=commercepulse

# PostgreSQL master password (use a strong, random password in production)
POSTGRES_PASSWORD=change_me_to_a_strong_password

# PostgreSQL database name
POSTGRES_DB=commercepulse

# PostgreSQL host (use service name in docker: postgres)
POSTGRES_HOST=localhost

# PostgreSQL port
POSTGRES_PORT=5432

# Full database connection URL (built from above vars)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://commercepulse:change_me_to_a_strong_password@localhost:5432/commercepulse

# ========================================
# Cache Configuration
# ========================================

# Redis host (use service name in docker: redis)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave empty for no auth in dev)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Full Redis connection URL
# Format: redis://:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# ========================================
# Security Configuration
# ========================================

# Application secret key for JWT tokens, session signing, etc.
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_with_openssl_rand_hex_32

# JWT access token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiration time (in days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing algorithm
PASSWORD_HASH_ALGORITHM=bcrypt

# CORS allowed origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========================================
# Storage Configuration
# ========================================

# Storage backend: local, s3, gcs
STORAGE_BACKEND=local

# Local storage path (used when STORAGE_BACKEND=local)
STORAGE_LOCAL_PATH=./storage/uploads

# AWS S3 Configuration (used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=commercepulse-uploads
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

# Maximum file upload size (in bytes, default: 100MB)
MAX_UPLOAD_SIZE=104857600

# ========================================
# Email Configuration
# ========================================

# Email backend: console, smtp, sendgrid, ses
EMAIL_BACKEND=console

# SMTP Configuration (used when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SendGrid Configuration (used when EMAIL_BACKEND=sendgrid)
SENDGRID_API_KEY=

# AWS SES Configuration (used when EMAIL_BACKEND=ses)
AWS_SES_REGION=us-east-1

# Default "From" email address
DEFAULT_FROM_EMAIL=noreply@commercepulse.local

# Support email address
SUPPORT_EMAIL=support@commercepulse.local

# ========================================
# Stripe / Payment Configuration
# ========================================

# Stripe publishable key (client-side)
STRIPE_PUBLISHABLE_KEY=pk_test_

# Stripe secret key (server-side)
STRIPE_SECRET_KEY=sk_test_

# Stripe webhook secret (for verifying webhook signatures)
STRIPE_WEBHOOK_SECRET=whsec_

# Default currency code (ISO 4217)
DEFAULT_CURRENCY=USD

# Payment provider: stripe, paypal, etc.
PAYMENT_PROVIDER=stripe

# ========================================
# Application Configuration
# ========================================

# Backend service port
BACKEND_PORT=8000

# Frontend service port
FRONTEND_PORT=3000

# Application environment: development, staging, production
APP_ENV=development

# Enable debug mode (set to false in production!)
DEBUG=true

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API version prefix
API_VERSION=v1

# Public URL of the application (used for generating links)
APP_URL=http://localhost:3000

# Public URL of the backend API
API_URL=http://localhost:8000

# Backend worker concurrency (Celery worker processes)
WORKER_CONCURRENCY=4

# Rate limiting: requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Rate limiting: requests per day per authenticated user
RATE_LIMIT_REQUESTS_PER_DAY=10000

# ========================================
# Frontend Configuration
# ========================================

# Next.js public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js public Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Enable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Node.js environment
NODE_ENV=development
